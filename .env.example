# Endereço público do site (sem barra no final), usado em canonical, Open Graph e dados estruturados.
# Ex.: VITE_SITE_URL=https://www.handytatui.com.br
VITE_SITE_URL=

# Use 1 apenas em ambientes que bloqueiam iframes (ex.: prévias) para mostrar o mapa ilustrado.
VITE_STATIC_MAP=

# Use 1 apenas em prévias onde só os arquivos .webp principais foram publicados.
VITE_SIMPLE_IMAGES=
